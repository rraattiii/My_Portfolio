@page "/"

<PageTitle>3D Sphere</PageTitle>

<div class="site-header" id="floatingHeader">Rati Kotchuashvili</div>

<div class="hero-section">
    <div class="hero-content">
        <div class="hero-left">
            <p class="hero-kicker">Interactive Portfolio</p>
            <h1 class="hero-title">Hi, I'm Rati, Software Developer specializing in C# and .NET</h1>
            <p class="hero-description">I build immersive digital experiences with clean code and modern design. Passionate about interactive web applications and engaging user interfaces.</p>
            <div class="hero-links">
                <a href="cv/Rati-Kotchuashvili-CV.pdf" class="hero-link hero-link-primary" download>
                    <span>Download CV</span>
                </a>
                <a href="https://github.com" class="hero-link" target="_blank" rel="noopener noreferrer">
                    <span>GitHub</span>
                </a>
                <a href="https://linkedin.com" class="hero-link" target="_blank" rel="noopener noreferrer">
                    <span>LinkedIn</span>
                </a>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-info-card">
                <p class="hero-label">Profile</p>
                <p class="hero-info-title">Software Developer focused on modern .NET web experiences.</p>
                <div class="hero-profile-list">
                    <div class="hero-profile-item">
                        <span class="hero-profile-key">Focus</span>
                        <span class="hero-profile-value">C#, .NET, Blazor</span>
                    </div>
                    <div class="hero-profile-item">
                        <span class="hero-profile-key">Based In</span>
                        <span class="hero-profile-value">Georgia</span>
                    </div>
                    <div class="hero-profile-item">
                        <span class="hero-profile-value">Open to work</span>
                    </div>
                </div>
                <p class="hero-label" style="margin-top: 24px;">Core Stack</p>
                <div class="hero-tags">
                    <span class="hero-tag">Blazor</span>
                    <span class="hero-tag">C#</span>
                    <span class="hero-tag">JavaScript</span>
                    <span class="hero-tag">HTML/CSS</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="sphere-page">
    <div class="about-panel">
        <div class="about-panel-inner">
            <p class="about-label" id="sectionTitle">About Me</p>
            <div class="about-panel-content">
                <p class="about-text" id="sectionText">Hi, I am a web developer who enjoys building immersive digital experiences. Scroll to see my education, experience, and contact info.</p>
                <div class="contact-links" id="contactLinks"></div>
            </div>
        </div>
    </div>
    <div class="sphere-container">
        <canvas id="sphereCanvas"></canvas>
    </div>
    <div class="cloud-popup" id="cloudPopup" aria-hidden="true">
        <div class="cloud-popup-card">
            <button class="cloud-popup-close" id="cloudPopupClose" type="button" aria-label="Close popup">Close</button>
            <p class="cloud-popup-kicker" id="cloudPopupKicker">Label</p>
            <h2 class="cloud-popup-title" id="cloudPopupTitle">Title</h2>
            <p class="cloud-popup-text" id="cloudPopupText">Description</p>
        </div>
    </div>
    <div class="scroll-space"></div>
</div>
